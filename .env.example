# Supabase → Project Settings → API. Only the URL and the anon/publishable key belong here.
# Never put the service_role / secret key in this file or in Vercel's VITE_ variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Set to true only after custom SMTP is configured in Supabase (enables "forgot password").
VITE_EMAIL_ENABLED=false

# Only for `npm run rls-check` (two throwaway test users you create yourself).
RLS_USER_A_EMAIL=
RLS_USER_A_PASSWORD=
RLS_USER_B_EMAIL=
RLS_USER_B_PASSWORD=
